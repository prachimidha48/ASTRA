# ASTRA - Astronaut Health Intelligence System
# Comprehensive .gitignore for NASA Space Apps Challenge Project

# Environment & Credentials
.env
.env.local
.env.*.local
*.env
*.pem
*.key
*.cert

# Databases & Backups
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backend/astra.db
.backup_security/

# Dependencies
node_modules/
frontend/node_modules/
.pnp
.pnp.js

# Build Outputs & Bundles
dist/
frontend/dist/
build/
*.egg-info/
.eggs/

# Python Cache & Virtual Environments
__pycache__/
*/__pycache__/
backend/__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
.env/

# Logs & Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.system_generated/

# Editor & OS Metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
